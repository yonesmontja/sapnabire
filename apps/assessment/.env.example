DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://eduerp:eduerp@127.0.0.1:5432/eduerp_assessment
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
# Harus sama persis dengan SERVICE_JWT_SECRET di apps/core-api/.env
SERVICE_JWT_SECRET=change-me-shared-secret-min-32-chars
SERVICE_JWT_ISSUER=eduerp-core
SERVICE_JWT_AUDIENCE=eduerp-assessment
# Callback ke Laravel saat job selesai (ditandatangani HMAC dengan SERVICE_JWT_SECRET)
CORE_CALLBACK_URL=http://127.0.0.1:8000/api/internal/assessment/callbacks
# Kredensial Claude: ANTHROPIC_API_KEY, atau profil `ant auth login`
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
